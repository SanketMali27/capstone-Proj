PORT=5000
# For local development, run MongoDB on your machine:
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge
# Or replace the value above with your MongoDB Atlas URI after allowing this machine IP in Atlas Network Access.
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
GOOGLE_MAPS_API_KEY=your_google_maps_key
CLIENT_URL=http://localhost:3000
NODE_ENV=development
